# Copy this file to ".env" and fill in your own values. ".env" is gitignored.
# Tavily is the paid last-resort provider; leave empty to run on free providers only.
TAVILY_API_KEY=
# Self-hosted SearXNG instance (enable "formats: [html, json]" in its settings.yml)
SEARXNG_URL=http://127.0.0.1:8888
# Access key for the web UI (optional: alternatively a random token.txt is generated on first run)
# JARVIS_TOKEN=
